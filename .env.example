# Modelo das variáveis de ambiente. Nenhum valor real aqui.
#
# Local : copie para .env.local e preencha (.env.local está no .gitignore).
# Vercel: Project Settings > Environment Variables.

# URL pública canônica. Usada na checagem de Origin da API, no metadataBase,
# no hreflang e no sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Origens extras autorizadas a postar em /api/contact, separadas por vírgula.
# Útil para os domínios de preview da Vercel. Pode ficar vazio.
ALLOWED_ORIGINS=""

# TODO: integrações ainda não ligadas (envio de e-mail, rate limit distribuído,
# API de dados). As variáveis de cada uma estão documentadas no próprio
# arquivo que vai consumi-las: lib/contact-delivery.ts, lib/rate-limit.ts e
# lib/api.ts.
#
# Nenhuma delas leva o prefixo NEXT_PUBLIC_, e isso é proposital: variável com
# esse prefixo é embutida no JavaScript enviado ao navegador — publicar uma
# chave assim equivale a comitá-la.
