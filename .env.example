# Copie para .env.local e preencha.  .env.local está no .gitignore.
# Na Vercel: Project Settings > Environment Variables.

# URL pública canônica. Usada na checagem de Origin da API, no metadataBase,
# no hreflang e no sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Origens extras autorizadas a postar em /api/contact, separadas por vírgula.
# Útil para os domínios de preview da Vercel. Pode ficar vazio.
ALLOWED_ORIGINS=""

# TODO: envio de e-mail (Resend) — ver seção 10 do README.
# Sem prefixo NEXT_PUBLIC_ de propósito: variável com esse prefixo vai para o
# bundle do navegador, ou seja, publicar a chave seria o mesmo que comitá-la.
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL=""
# CONTACT_FROM_EMAIL=""

